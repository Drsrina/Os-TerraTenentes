# 🔑 Chaves de Deploy Rápido & Configurações de Publicação
# Copie este arquivo para .env e preencha suas chaves privadas

# GitHub Deploy Key / Personal Access Token (PAT)
GITHUB_DEPLOY_KEY=ghp_sua_chave_de_deploy_rapida_aqui
GITHUB_REPOSITORY=seu-usuario/os-terratenentes-rpg

# Deploy para Vercel / Netlify / Cloudflare Pages (Opcional)
VERCEL_TOKEN=
NETLIFY_AUTH_TOKEN=

# Configuração de Ambiente
APP_ENV=production
SITE_URL=https://seu-dominio.github.io/os-terratenentes-rpg/
